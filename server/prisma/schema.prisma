// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model user {
  id              String  @id @default(cuid())
  umindanao_email String  @unique
  google_id       String  @unique
  role            String
  done_onboarding Boolean @default(false)

  last_login_at DateTime?

  deleted_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  refresh_tokens      refresh_token[]
  events              events[]
  student             student?
  attendance          attendance[]
  attendance_check_in attendance[]    @relation("CheckInByUser")
  attendance_check_ou attendance[]    @relation("CheckOutByUser")
  organizers_added    organizers[]    @relation("OrganizerAddedBy")
  organizers          organizers[]    @relation("OrganizerUser")

  @@index([umindanao_email])
  @@index([role])
  @@index([created_at])
  @@index([last_login_at])
  @@index([deleted_at])
  @@map("users")
}

model student {
  id              String  @id @default(cuid())
  user_id         String  @unique
  student_id      Int     @unique
  name            String
  department      String?
  program         String?
  profile_picture String

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  attendance attendance[]

  @@index([department])
  @@index([program])
  @@index([student_id])
  @@map("students")
}

model refresh_token {
  id         String @id @default(cuid())
  user_id    String
  token_hash String @unique

  ip_address String?
  browser    String?
  os         String?
  device     String?
  city       String?
  region     String?
  country    String?

  is_active  Boolean   @default(true)
  revoked_at DateTime?
  expires_at DateTime
  last_used  DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@index([is_active])
  @@index([token_hash])
  @@map("refresh_tokens")
}

model events {
  id                 String    @id @default(cuid())
  title              String
  description        String
  department         String
  location           String
  capacity           Int?
  all_day            Boolean   @default(false)
  start_time         DateTime?
  end_time           DateTime?
  check_out_required Boolean   @default(false)
  is_started         Boolean   @default(false)
  is_done            Boolean   @default(false)

  form_fields Json?

  created_by String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       user         @relation(fields: [created_by], references: [id], onDelete: Cascade)
  attendance attendance[]
  organizers organizers[]

  @@index([title])
  @@index([department])
  @@index([location])
  @@index([start_time])
  @@index([end_time])
  @@index([created_by])
  @@map("events")
}

model attendance {
  id           String    @id @default(cuid())
  event_id     String
  student_id   Int
  check_in_at  DateTime  @default(now())
  check_out_at DateTime?

  check_in_by  String
  check_out_by String?

  event             events  @relation(fields: [event_id], references: [id], onDelete: Cascade)
  student           student @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  check_in_by_user  user    @relation("CheckInByUser", fields: [check_in_by], references: [id], onDelete: Cascade)
  check_out_by_user user?   @relation("CheckOutByUser", fields: [check_out_by], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       user[]

  @@index([event_id])
  @@index([student_id])
  @@index([check_in_at])
  @@index([check_out_at])
  @@map("attendances")
}

model organizers {
  id       String @id @default(cuid())
  user_id  String
  event_id String
  added_by String

  user    user   @relation("OrganizerUser", fields: [user_id], references: [id], onDelete: Cascade)
  event   events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  addedBy user   @relation("OrganizerAddedBy", fields: [added_by], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, event_id])
  @@index([user_id])
  @@index([event_id])
  @@map("organizers")
}
