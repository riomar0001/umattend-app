# Local values for `wrangler dev`. Copy to `.dev.vars` (git-ignored).
#
# In production these are NOT set here — non-secret values live in the `vars`
# block of wrangler.jsonc, and secrets are uploaded with:
#     wrangler secret put <NAME>
#
# There is no DATABASE_URL: D1 is reached through the `DB` binding.
# There is no PORT: a Worker does not bind one.
# There is no REDIS_*: replaced by the EPHEMERAL_STORE Durable Object.

NODE_ENV=DEVELOPMENT

# ---------- URLs / CORS ----------
API_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Widens the auth cookies to the registrable domain so the frontend and API
# hosts share them (e.g. .umattend.site). Leave EMPTY locally — on localhost a
# host-only cookie is correct and a domain here would stop it being stored.
COOKIE_DOMAIN=

# ---------- JWT ----------
# Generate fresh secrets, e.g. `openssl rand -hex 32`. Do not reuse the ones
# that were previously committed to .env.example.
#
# The TTLs are a bare number of HOURS, not a timespan string. The code appends
# the unit itself (`${TTL}h` for jwt.sign) and multiplies out for cookie maxAge,
# so "3h" here becomes "3hh" and jwt.sign rejects it.
JWT_ACCESS_TOKEN_SECRET=
JWT_ACCESS_TOKEN_TTL=3
JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_TTL=24
JWT_GOOGLE_STATE_SECRET=

# Student QR attendance token. TTL is in SECONDS here, unlike the hour-based
# TTLs above (user.service.ts passes it to jwt.sign as a bare number).
JWT_ATTENDANCE_TOKEN_SECRET=
JWT_ATTENDANCE_TOKEN_TTL=300

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ---------- SMTP (Gmail) ----------
# Cloudflare blocks outbound port 25; use 587 (STARTTLS) or 465 (implicit TLS).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false

# The mailbox that authenticates. MAIL_PASS must be a 16-character Google App
# Password (requires 2-Step Verification) — a normal account password is
# rejected. Generate at https://myaccount.google.com/apppasswords
MAIL_USER=
MAIL_PASS=

# The address recipients see. Gmail only honours this if it is verified in that
# account under Settings -> Accounts and Import -> "Send mail as"; otherwise
# Gmail rewrites the From header back to MAIL_USER.
MAIL_FROM=
MAIL_FROM_NAME=

# ---------- Queues ----------
# Queue names matching the bindings in wrangler.jsonc. The admin dead-letter
# viewer reads the DLQ over the Queues REST API, which addresses queues by name
# — a binding carries none at runtime.
EMAIL_QUEUE_NAME=umattend-email
EVENT_STATUS_QUEUE_NAME=umattend-event-status
DLQ_NAME=umattend-dlq

# Only needed to open the admin dead-letter page; everything else runs without
# them (getQueuesConfig() is read lazily, per request).
#
# CF_API_TOKEN needs Queues **Read and Write** — a pull consumer writes queue
# state in order to acknowledge, so a read-only token cannot even list messages.
# Create one at https://dash.cloudflare.com/profile/api-tokens
CF_ACCOUNT_ID=b8d3ac74f68e959d2c02abaff44dd65f
CF_API_TOKEN=

# ---------- Frontend proxy ----------
# Shared with the Next.js middleware in client/src/middleware.ts.
#
# The frontend rewrites /api/* to this Worker, so the Worker's CF-Connecting-IP
# is the Vercel function, not the visitor — which is why login history used to
# record AWS datacenters and why every visitor shared one rate-limit bucket. The
# middleware forwards the real IP and location; this secret is what lets the
# Worker trust those headers instead of treating them as a spoofable claim.
#
# Generate with `openssl rand -hex 32` and set the SAME value in both places:
#   wrangler secret put API_PROXY_SECRET
#   vercel env add API_PROXY_SECRET
#
# Leave empty to disable: both sides then fall back to CF-Connecting-IP.
API_PROXY_SECRET=
