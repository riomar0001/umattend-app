# The server now runs on Cloudflare Workers, which does not read .env files.
#
#   local development  -> .dev.vars      (see .dev.vars.example)
#   deployed vars      -> wrangler.jsonc `vars` block
#   deployed secrets   -> wrangler secret put <NAME>
#
# The only variable still read from a .env file is the one below, and only by
# the Prisma CLI when generating migration SQL — never by the running Worker.
# It points at a throwaway local SQLite file used as a diff target; the real
# database is Cloudflare D1, reached through the `DB` binding.

PRISMA_MIGRATE_SHADOW_URL=file:./prisma/.shadow.db
