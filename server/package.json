{
  "name": "umattend-app",
  "version": "1.0.0",
  "description": "",
  "main": "src/worker/index.ts",
  "scripts": {
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check .",
    "format:check:ci": "./node_modules/.bin/prettier --check .",
    "type-check": "tsc --noEmit",
    "dev": "wrangler dev --env=\"\"",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env=\"\"",
    "tail:staging": "wrangler tail --env staging",
    "tail:prod": "wrangler tail --env=\"\"",
    "cf-typegen": "wrangler types",
    "prisma:generate": "prisma generate",
    "db:migrate:new": "wrangler d1 migrations create umattend",
    "db:migrate:diff": "prisma migrate diff --from-local-d1 --to-schema-datamodel prisma/schema.prisma --script",
    "db:migrate:init": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "db:migrate:local": "wrangler d1 migrations apply umattend --local --env=\"\"",
    "db:migrate:staging": "wrangler d1 migrations apply umattend-staging --remote --env staging",
    "db:migrate:prod": "wrangler d1 migrations apply umattend --remote --env=\"\""
  },
  "keywords": [],
  "author": "",
  "license": "",
  "type": "module",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@scalar/express-api-reference": "^0.8.20",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "ua-parser-js": "^2.0.5",
    "uuid": "^14.0.0",
    "zod": "^4.1.8",
    "@prisma/adapter-d1": "^6.19.3",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.1.3",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "@cloudflare/workers-types": "^4.20260611.1",
    "wrangler": "~4.100.0"
  },
  "overrides": {
    "uuid": "^14.0.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "workerd@1.20260611.1": true,
    "esbuild@0.27.3": true,
    "unrs-resolver@1.12.2": true
  }
}
