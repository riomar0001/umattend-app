{
  "id": null,
  "uid": "umattend-postgres",
  "title": "UMAttend — PostgreSQL",
  "tags": ["umattend", "postgres"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Metrics",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Database Size",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "pg_stat_database_size_bytes{datname!~\"template.*|postgres\"}",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count{state=\"active\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Transactions / sec",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache Hit Ratio",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "100 * sum(rate(pg_stat_database_blks_hit{datname!~\"template.*|postgres\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname!~\"template.*|postgres\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname!~\"template.*|postgres\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Transactions per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "commits - {{datname}}",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "rollbacks - {{datname}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Active Connections Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "pg_stat_activity_count{datname!~\"template.*|postgres\"}",
          "legendFormat": "{{datname}} - {{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Cache Hit / Miss Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_hit{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "hit - {{datname}}",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_blks_read{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "read - {{datname}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Tuples (Rows) Activity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_fetched{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "fetched - {{datname}}",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_tup_inserted{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "inserted - {{datname}}",
          "refId": "B"
        },
        {
          "expr": "rate(pg_stat_database_tup_updated{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "updated - {{datname}}",
          "refId": "C"
        },
        {
          "expr": "rate(pg_stat_database_tup_deleted{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "deleted - {{datname}}",
          "refId": "D"
        }
      ]
    },
    {
      "id": 9,
      "title": "Conflicts & Deadlocks",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops",
          "custom": { "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "rate(pg_stat_database_conflicts{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "conflicts - {{datname}}",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_deadlocks{datname!~\"template.*|postgres\"}[5m])",
          "legendFormat": "deadlocks - {{datname}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "Locks by Mode",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "expr": "pg_locks_count{datname!~\"template.*|postgres\"}",
          "legendFormat": "{{datname}} - {{mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Current Locks",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": { "showHeader": true },
      "targets": [
        {
          "expr": "pg_locks_count{datname!~\"template.*|postgres\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "PostgreSQL Up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "value": "0", "text": "DOWN" },
            { "type": "value", "value": "1", "text": "UP" }
          ]
        }
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "" },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "pg_up",
          "refId": "A"
        }
      ]
    }
  ]
}
